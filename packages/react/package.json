{
  "name": "@siberui/react",
  "version": "1.4.1",
  "description": "Siber-Minimalist Cyberpunk React UI Kit",

  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./globals.css": "./src/styles/globals.css"
  },
  "files": [
    "dist",
    "src/styles/globals.css"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run verify"
  },
  "keywords": [
    "react",
    "ui-kit",
    "tailwindcss",
    "cyberpunk",
    "siber-minimalism",
    "components"
  ],
  "author": {
    "name": "Volkan Özbek",
    "url": "https://github.com/volkanozbek"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siberui/siber-ui.git"
  },
  "bugs": {
    "url": "https://github.com/siberui/siber-ui/issues"
  },
  "homepage": "https://siberui.com",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "8.20.6",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "react-day-picker": "8.10.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}